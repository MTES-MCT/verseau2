# Config portée par l'app mutualisée chez le fournisseur
VITE_API_BASE_URL=http://localhost:3000/api

# Optional: deploy behind a reverse proxy under a subpath (example: /verseau/)
# VITE_BASE_PATH=/verseau/

# Optional: explicit API URL when the app is served under a subpath
# VITE_API_BASE_URL=/verseau/api

# Optional: For development with mock authentication
# VITE_FAKE_TOKEN=dev-token-123
