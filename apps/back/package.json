{
  "name": "back",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc --build && nest build",
    "start": "node dist/mainServer.js & node dist/mainWorker.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "concurrently \"pnpm start:server:dev\" \"pnpm start:worker:dev\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:server:dev": "nodemon --config nodemon-server.json",
    "start:worker:dev": "nodemon --config nodemon-worker.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "clean": "rm -rf dist node_modules",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:ci": "pnpm test && pnpm test:e2e:api-worker",
    "test:unit": "jest --maxWorkers=4",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --maxWorkers=6",
    "test:e2e:api-worker": "jest --config ./test/jest-e2e-api-worker.json --runInBand",
    "migrate:run": "typeorm-ts-node-commonjs migration:run -d ./src/infra/database/migrationDatasource.ts",
    "migrate:generate": "typeorm-ts-node-commonjs migration:generate -d ./src/infra/database/migrationDatasource.ts",
    "migrate:create": "typeorm migration:create"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@getbrevo/brevo": "^6.0.3",
    "@lib/dossier": "workspace:*",
    "@lib/parser": "workspace:*",
    "@lib/shared": "workspace:*",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.20.0",
    "basic-ftp": "^6.2.1",
    "cache-manager": "^7.2.9",
    "cookie-parser": "^1.4.7",
    "fflate": "^0.8.3",
    "form-data": "^4.0.6",
    "jose": "^6.2.12",
    "nestjs-cls": "^6.3.0",
    "nodemailer": "^10.0.10",
    "openid-client": "^6.8.8",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ssh2": "1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "typeorm": "^1.1.1",
    "ulid": "^3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/ssh2": "1.15.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/supertest": "^7.2.1",
    "arch-unit-ts": "^1.0.12",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "nodemon": "^3.1.14",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "setupFiles": [
      "<rootDir>/../test/jest.setup.ts"
    ],
    "silent": true,
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.pnpm|openid-client|oauth4webapi|jose)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "watchman": false,
    "moduleNameMapper": {
      "^@queue/(.*)$": "<rootDir>/infra/queue/$1",
      "^@database/(.*)$": "<rootDir>/infra/database/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@worker/(.*)$": "<rootDir>/worker/$1",
      "^@depot/(.*)$": "<rootDir>/depot/$1",
      "^@s3/(.*)$": "<rootDir>/infra/s3/$1",
      "^@dossier/(.*)$": "<rootDir>/dossier/$1",
      "^@referentiel/(.*)$": "<rootDir>/referentiel/$1",
      "^@notification/(.*)$": "<rootDir>/notification/$1",
      "^@infra/(.*)$": "<rootDir>/infra/$1",
      "^@masa/(.*)$": "<rootDir>/masa/$1",
      "^@user/(.*)$": "<rootDir>/user/$1",
      "^@authentication/(.*)$": "<rootDir>/authentication/$1",
      "^@lib/dossier$": "<rootDir>/../../../packages/dossier/src/index.ts",
      "^@lib/parser$": "<rootDir>/../../../packages/parser/src/index.ts",
      "^@lib/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
    },
    "coveragePathIgnorePatterns": [
      "/dist/",
      "/infra/",
      "/referentiel/",
      "/notification/",
      ".*\\.module\\.ts",
      ".*\\.mock\\.ts",
      ".*\\.factory\\.ts",
      ".*\\.entity\\.ts"
    ]
  }
}
