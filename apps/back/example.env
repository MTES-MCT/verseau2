DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verseau2

# Migrations
RUN_MIGRATIONS_ON_STARTUP=false # Set to true to run pending migrations on API server startup with advisory lock safety

# QUEUE
QUEUE_PREFIX=feat-xyz # optionnel - permet d'isoler les worker sur la base de recette partagée

# SANDRE Mock Configuration
USE_SANDRE_MOCK=false
# Optional: Configure mock behavior
# SANDRE_MOCK_BEHAVIOR=conformant
# SANDRE_MOCK_CONFORMANT_RATE=0.5

S3_PROVIDER=outscale #ou mock
S3_BUCKET=MY_BUCKET
S3_ENDPOINT=OUTSCALE_ENDPOINT
S3_REGION=OUTSCALE_REGION
S3_ACCESS_KEY=MY_ACCESS_KEY
S3_SECRET_KEY=MY_SECRET_KEY

LOGS_LEVEL=debug # or verbose
DATABASE_LOGGING=true # or false
TIMESTAMP_LOGGING=false # or true

# Email
EMAIL_PROVIDER=mock # or brevo or mailcatcher
BREVO_API_KEY=your-brevo-api-key
MAILCATCHER_HOST=localhost
MAILCATCHER_PORT=1025

# OpenID Connect
OIDC_ISSUER_URL=https://your-oidc-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=verseau2
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:5173/callback
# Optional explicit frontend origin for cross-origin frontend/backend deployments.
CORS_ORIGIN=
# Production behind reverse proxy example: https://saineau.beta.gouv.fr/verseau/callback
OIDC_MOCK=false
OIDC_MOCK_EMAIL=email@email.com # si OIDC_MOCK=true

# JWT interne Verseau2
JWT_SECRET=supersecret

# SFTP Configuration
SFTP_PROVIDER=mock # or real
SFTP_HOST=localhost
SFTP_PORT=22
SFTP_USERNAME=user
SFTP_PRIVATE_KEY=key

# SFTP Agences de l'eau (multi-provider)
SFTP_AGENCY_PROVIDER=mock # or real
# Configuration JSON des SFTP pour chaque agence de l'eau
# Format: {"agence_id": {"host": "hostname", "port": 22, "username": "user", "remotePath": "base/path", "rejectionRemotePath": "optional/rejections/path"}}
# rejectionRemotePath est optionnel. S'il est absent, les rejets sont envoyés dans remotePath.
# Exemple:
SFTP_AGENCY_CONFIG={ "11111111111111": { "host": "sftp1.example.com", "port": 22, "username": "user1", "remotePath": "test-agency-1", "rejectionRemotePath": "test-agency-1-rejections" }, "22222222222222": { "host": "sftp2.example.com", "port": 2222, "username": "user2", "remotePath": "test-agency-2" } }

# Base64 private key 
SFTP_AGENCY_PRIVATE_KEY_11111111111111=a2V5MQo=
SFTP_AGENCY_PRIVATE_KEY_22222222222222=a2V5Mgo=

# MASA webhook
MASA_API_KEY=
