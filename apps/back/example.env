DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verseau2

# Migrations
RUN_MIGRATIONS_ON_STARTUP=false # Set to true to run pending migrations on API server startup with advisory lock safety

# SANDRE Mock Configuration
USE_SANDRE_MOCK=false
# Optional: Configure mock behavior
# SANDRE_MOCK_BEHAVIOR=conformant
# SANDRE_MOCK_CONFORMANT_RATE=0.5

S3_PROVIDER=outscale #ou mock
S3_BUCKET=MY_BUCKET
S3_ENDPOINT=OUTSCALE_ENDPOINT
S3_REGION=OUTSCALE_REGION
S3_ACCESS_KEY=MY_ACCESS_KEY
S3_SECRET_KEY=MY_SECRET_KEY

LOGS_LEVEL=debug # or verbose

# Email
EMAIL_PROVIDER=mock # or brevo or #mailcatcher

# OpenID Connect
OIDC_ISSUER_URL=https://your-oidc-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=verseau2
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_MOCK=false

# SFTP Configuration
SFTP_PROVIDER=mock # or real
SFTP_HOST=localhost
SFTP_PORT=22
SFTP_USERNAME=user
SFTP_PRIVATE_KEY=key

# SFTP Agences de l'eau (multi-provider)
SFTP_AGENCY_PROVIDER=mock # or real
# Configuration JSON des SFTP pour chaque agence de l'eau
# Format: {"agence_id": {"host": "hostname", "port": 22, "username": "user", "privateKey": "key"}}
# Exemple:
# SFTP_AGENCY_CONFIG={"agence_01": {"host": "sftp.agence1.fr", "port": 22, "username": "user1"}, "agence_02": {"host": "sftp.agence2.fr", "port": 22, "username": "user2", "privateKey": "-----BEGIN RSA PRIVATE KEY-----\n..."}}
SFTP_AGENCY_CONFIG=

# MASA webhook
MASA_WEBHOOK_MOCK=true
MASA_API_KEY=