{
  "name": "verseau-antivirus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x", "pnpm": "12.5.0" },
  "packageManager": "pnpm@12.5.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --test --test-timeout=15000 test/*.test.ts",
