# Local scanner configuration. Copy to .env.local and fill in the token.
# After pnpm build, run: node --env-file=.env.local dist/main.js
# The scanner does not automatically load .env files.
NODE_ENV=development

# Required: random secret, 32–512 printable ASCII characters without spaces.
# Must match the backend's ANTIVIRUS_TOKEN. Never commit the real value.
ANTIVIRUS_TOKEN=

# Bind hostname/IP only, without http://, a path, or a port.
ANTIVIRUS_HOST=127.0.0.1
ANTIVIRUS_PORT=3011
ANTIVIRUS_PRIVATE_ONLY=false

# Absolute Unix socket path of a running clamd daemon (no TCP connection).
CLAMD_SOCKET_PATH=/app/clamav/run/clamd.sock

# Scan deadline, readiness-probe timeout, and maximum loaded-signature age.
SCAN_TIMEOUT_MS=120000
CLAMD_PROBE_TIMEOUT_MS=3000
SIGNATURE_MAX_AGE_HOURS=48

# Scalingo production:
# - Set NODE_ENV=production and ANTIVIRUS_PRIVATE_ONLY=true.
# - Remove the local ANTIVIRUS_HOST value: the Procfile maps the platform's
#   injected private hostname automatically. An explicit override must resolve
#   to this container's private interface, never 0.0.0.0 or loopback.
# - Set PROJECT_DIR=apps/antivirus in Scalingo before building.
# - Set CLAMAV_VERSION to an audited, currently supported release before building.
# - Run scanner:1 (2XL initially) and web:0 on the backend's Private Network.
# - Leave CLAMD_DISABLE_DAEMON and FRESHCLAM_DISABLE_DAEMON unset.
# - Do not include scanner in CLAMAV_DISABLE_PROCESS_TYPES (default below).
# CLAMAV_DISABLE_PROCESS_TYPES=postdeploy,one-off
# ANTIVIRUS_URL belongs on the backend, not here:
# http://scanner.<application-id>.<private-network-id>.private-network.internal:3011
