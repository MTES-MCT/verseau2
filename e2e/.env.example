# Documented defaults for the isolated E2E stack (not automatically loaded).
# E2E_DOCKER_HOST is the runner's configurable hostname for Docker-published ports.
E2E_FRONT_URL=http://localhost:5173
E2E_API_URL=http://localhost:3000/api
E2E_POSTGRES_PORT=54329
E2E_S3_PORT=9099
E2E_DOCKER_HOST=localhost

# When running inside a container with a sibling Docker-in-Docker daemon,
# published ports may be reachable on the daemon hostname, not localhost.
# Set this in your shell before running pnpm test:e2e (this file is not loaded automatically):
# export E2E_DOCKER_HOST=docker
