{
  "name": "verseau2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm --filter front build && pnpm --filter back build",
    "start": "pnpm --filter back start",
    "dev": "concurrently \"pnpm dev:back\" \"pnpm dev:front\"",
    "dev:back": "pnpm --filter back dev",
    "dev:front": "pnpm --filter front dev",
    "prepare": "husky",
    "clean": "pnpm --filter back clean && pnpm --filter front clean && pnpm --filter parser clean && pnpm --filter dossier clean && pnpm --filter shared clean",
    "test": "pnpm --filter back test && pnpm --filter parser test",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "knip": "^5.85.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.1.2"
  }
}
