{
  "name": "verseau2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "pnpm --filter front build && pnpm --filter back build",
    "start": "pnpm --filter back start",
    "dev": "concurrently \"pnpm dev:back\" \"pnpm dev:front\"",
    "dev:back": "pnpm --filter back dev",
    "dev:front": "pnpm --filter front dev",
    "prepare": "husky",
    "clean": "pnpm --filter back run clean && pnpm --filter front run clean && pnpm --filter parser run clean && pnpm --filter dossier run clean && pnpm --filter shared run clean",
    "test": "pnpm -r --if-present test",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "knip": "^6.35.1",
    "prettier": "^3.9.7",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
