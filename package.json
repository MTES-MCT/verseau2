{
  "name": "verseau2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.0",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "build": "node -e \"if(process.env.SOURCE_VERSION){require('node:fs').writeFileSync('.source-version',process.env.SOURCE_VERSION)}\" && pnpm --filter front build && pnpm --filter back build",
    "start": "pnpm --filter back start",
    "dev": "concurrently \"pnpm dev:back\" \"pnpm dev:front\"",
    "dev:back": "pnpm --filter back dev",
    "dev:front": "pnpm --filter front dev",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "test:e2e:open": "pnpm --filter e2e test:e2e:open",
    "prepare": "husky",
    "clean": "pnpm --filter back run clean && pnpm --filter front run clean && pnpm --filter parser run clean && pnpm --filter dossier run clean && pnpm --filter shared run clean",
    "test": "pnpm -r --if-present test",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
