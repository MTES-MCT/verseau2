client_max_body_size 100m;

# ── Verseau ──
location /verseau/ {
    proxy_pass <%= ENV['VERSEAU_UPSTREAM_URL'] %>/;
    proxy_set_header Host <%= ENV['VERSEAU_UPSTREAM_HOST'] %>;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /verseau;
    proxy_ssl_server_name on;
}

# Redirect /verseau (sans trailing slash) -> /verseau/
location = /verseau {
    return 308 /verseau/;
}

# ── Page d'accueil ──
location = / {
    return 302 /verseau/;
}
