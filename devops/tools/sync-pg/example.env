# AWS Configuration
S3_REGION=cloudgouv-eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_DUMP_FOLDER=dump

# Postgres Configuration
DATABASE_URL=postgresql://user:password@host:port/database
DDL_SYNC=false

# Required. Comma-separated list of tables to exclude from pg_restore.
# Format: dump_schema.table_name
SYNC_PG_EXCLUDED_TABLES=schema1.table1,schema1.table2,schema2.table1

# Tchap notifications (optional locally, but all four variables are required to notify)
# The bot account must already have joined the unencrypted bot-saineau room
# and must have permission to send messages there.
TCHAP_HOMESERVER_URL=https://matrix.example.gouv.fr
TCHAP_ACCESS_TOKEN=
TCHAP_ROOM_ID=!room-id:matrix.example.gouv.fr
TCHAP_USER_ID=@bot-saineau:matrix.example.gouv.fr

# Optional HTTP(S) dashboard link included in success and failure reports (no credentials).
SYNC_PG_LOGS_URL=

# Optional. Environment label included in the Tchap report (e.g. Recette, Production).
# The values 'production' and 'prod' are displayed as bold PRODUCTION.
SYNC_PG_ENV=
